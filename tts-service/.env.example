APP_NAME="BornoVerse TTS Service"
APP_VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8001

# Gemini API settings
GEMINI_API_KEY=""
GEMINI_OCR_MODEL="gemini-2.5-flash"
GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
GEMINI_VOICE="Puck"
TTS_PROVIDER="gemini"

# Model settings
BANGLA_MODEL_REPO="EMTIAZZ/bangladeshi-bangla-tts-vits"
XTTS_MODEL_NAME="tts_models/multilingual/multi-dataset/xtts_v2"
USE_CUDA=false

# Platform API integration
PLATFORM_API_URL="http://localhost:8000/api/v1"
OUTPUT_DIR="output"

# More Gemini keys (other Google accounts), comma separated. TTS rotates through
# GEMINI_API_KEY + these, keeping each under its free-tier limits.
GEMINI_API_KEYS=
GEMINI_TTS_RPM=5
GEMINI_TTS_RPD=10
# true: narrate only with GEMINI_TTS_MODEL; when every key is used up for the day,
# generation pauses and resumes after the reset (no Edge/gTTS voices).
GEMINI_TTS_ONLY=true
