# ==============================================================================
# Environment Configuration for BornoVerse API
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.
# ==============================================================================

# Application
APP_NAME="BornoVerse API"
APP_VERSION="0.1.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# Database
# Async connection for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/audiobook_db
# Sync connection for Alembic migrations (psycopg)
SYNC_DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/audiobook_db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
# "local" (disk only) or "supabase" (disk cache mirrored to Supabase Storage; for Render)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Model Runner Integration Boundary
MODEL_RUNNER_DISPATCHER=http
MODEL_RUNNER_URL=http://localhost:8001/jobs

# TTS / OCR service (must match tts-service/.env TTS_SERVICE_KEY)
TTS_SERVICE_KEY=change-me-shared-internal-key
TTS_GENERATE_URL=http://localhost:8001/generate
TTS_EXTRACT_URL=http://localhost:8001/extract-page

# Push notifications through the Expo Push API (no key needed for Expo tokens)
PUSH_NOTIFICATIONS_ENABLED=true

# Google sign-in via Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Storage only: service_role / secret key (server-side, never in the app) and bucket name
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Payments: SSLCommerz sandbox (https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Public URL of this API for SSLCommerz IPN; leave empty on LAN (derived per request)
PUBLIC_API_BASE_URL=
PAYMENT_RETURN_SCHEMES=bornoverse,exp,exps

# Development-only simulated payments when SSLCommerz is not configured
ENVIRONMENT=development
MOCK_PAYMENTS_ENABLED=false

# Password recovery email (optional; recovery returns 503 until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
