{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bornoverse-api.onrender.com/api/$1"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
